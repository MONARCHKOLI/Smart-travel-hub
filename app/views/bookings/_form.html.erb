<%= form_with(model: booking, class: "space-y-10") do |form| %>

  <% if booking.errors.any? %>
    <div class="rounded-[28px] border border-red-100 bg-red-50 p-6">
      <h2 class="text-red-700 font-black text-lg">
        <%= pluralize(booking.errors.count, "error") %>
        prevented reservation
      </h2>

      <ul class="mt-4 text-red-600 space-y-2">
        <% booking.errors.each do |error| %>
          <li>• <%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>


  <%= form.hidden_field :user_id,
      value: current_user.id %>

  <%= form.hidden_field :room_id,
      value: @room.id %>

  <%= form.hidden_field :status,
      value: "pending" %>


  <!-- Reservation Details -->

  <div class="grid grid-cols-1 xl:grid-cols-2 gap-8">

    <div class="bg-white rounded-[32px] p-8 shadow-lg border">

      <h3 class="text-2xl font-black mb-6">
        🍽 Reservation Time
      </h3>

      <%= form.datetime_field :reservation_time,
          required: true,
          min: Time.current.strftime("%Y-%m-%dT%H:%M"),
          class: "
          w-full
          rounded-2xl
          border-gray-200
          py-4
          px-5
          " %>

    </div>


    <div class="bg-white rounded-[32px] p-8 shadow-lg border">

      <h3 class="text-2xl font-black mb-6">
        👥 Guests
      </h3>

      <%= form.number_field :guest_count,
          value: booking.guest_count || 2,
          min: 1,
          max: 20,
          class: "
          w-full
          rounded-2xl
          border-gray-200
          py-4
          px-5
          " %>

    </div>

  </div>


  <!-- Dining Space -->

  <div class="
  bg-gradient-to-r
  from-orange-50
  to-pink-50
  rounded-[36px]
  p-8
  shadow-xl
  ">

    <div class="flex flex-col lg:flex-row gap-8">

      <% if @room.image.attached? %>

        <%= image_tag @room.image,
            class: "
            w-full
            lg:w-72
            h-72
            object-cover
            rounded-[30px]
            " %>

      <% end %>


      <div class="flex-1">

        <span class="
        bg-orange-100
        px-4
        py-2
        rounded-full
        text-orange-600
        font-bold
        ">
          Premium Dining
        </span>

        <h2 class="mt-5 text-4xl font-black">
          <%= @room.room_type %>
        </h2>

        <p class="mt-4 text-gray-600">
          Fine ambience, premium experience,
          curated dining.
        </p>

      </div>


      <div class="
      bg-white
      p-8
      rounded-[30px]
      shadow-lg
      min-w-[220px]
      ">

        <p class="
        text-gray-400
        uppercase
        font-bold
        text-sm
        ">
          Reservation Price
        </p>

        <div class="
        mt-4
        text-5xl
        font-black
        text-orange-600
        ">
          ₹<%= @room.price.to_i %>
        </div>

      </div>

    </div>

  </div>


  <!-- Gourmet Menu -->

  <div class="
  bg-white
  rounded-[36px]
  border
  shadow-2xl
  overflow-hidden
  ">

    <div class="
    px-6
    py-7
    bg-orange-50
    border-b
    ">

      <div class="
      flex
      flex-col
      lg:flex-row
      justify-between
      gap-4
      ">

        <div>

          <h2 class="text-3xl font-black">
            🍔 Gourmet Menu
          </h2>

          <p class="text-gray-500 mt-2">
            Select dishes for your reservation
          </p>

        </div>


        <div class="relative">

          <input
            type="text"
            id="food-search"
            placeholder="Search dishes..."
            class="
            w-full
            lg:w-80
            rounded-2xl
            border-gray-200
            pl-10
            py-4
            "
          />

          <span class="
          absolute
          left-4
          top-1/2
          -translate-y-1/2
          ">
            🔍
          </span>

        </div>

      </div>

    </div>



    <div class="
    p-6
    grid
    grid-cols-1
    sm:grid-cols-2
    xl:grid-cols-3
    gap-6
    ">

      <% @motel.food_items.each_with_index do |item,index| %>

        <label
          data-food-card
          data-name="<%= item.name.downcase %>"
          class="
          food-card
          <%= 'hidden extra-food' if index > 8 %>
          bg-gray-50
          rounded-[28px]
          overflow-hidden
          border
          hover:shadow-xl
          cursor-pointer
          transition
          ">

          <% if item.image.attached? %>

            <%= image_tag item.image,
                class: "
                w-full
                h-48
                object-cover
                " %>

          <% end %>


          <div class="p-5">

            <div class="flex justify-between">

              <h4 class="text-lg font-black">
                <%= item.name %>
              </h4>

              <span class="text-orange-600 font-black">
                ₹<%= item.price.to_i %>
              </span>

            </div>


            <div class="
            mt-4
            flex
            justify-between
            items-center
            ">

              <span class="text-sm text-gray-500">
                ⏱ <%= item.prep_time_minutes %> mins
              </span>


              <input
                type="checkbox"
                name="booking[food_item_ids][]"
                value="<%= item.id %>"
                data-price="<%= item.price.to_i %>"

                <%= "checked" if Array(
                    booking.food_item_ids
                  ).map(&:to_s)
                    .include?(item.id.to_s) %>

                class="
                food-checkbox
                rounded
                text-orange-500
                "
              />

            </div>

          </div>

        </label>

      <% end %>

    </div>


    <% if @motel.food_items.count > 9 %>

      <div class="p-8 flex justify-center">

        <button
          type="button"
          id="load-more-food"
          class="
          bg-orange-500
          hover:bg-orange-600
          text-white
          px-8
          py-4
          rounded-2xl
          font-bold
          ">

          Load More Menu

        </button>

      </div>

    <% end %>

  </div>


  <!-- Payment -->

  <%
    base_amount = @room.price.to_i
    deposit_amount = (base_amount * 0.2).to_i
    remaining_amount = base_amount - deposit_amount
  %>


  <div class="
  bg-gray-950
  rounded-[36px]
  p-6 sm:p-10
  text-white
  ">

    <div class="
    grid
    grid-cols-1
    md:grid-cols-3
    gap-6
    ">

      <div class="bg-white/5 p-6 rounded-3xl">

        <p class="text-gray-400 uppercase font-bold text-sm">
          Deposit (20%)
        </p>

        <h3
          id="deposit-amount"
          class="
          mt-3
          text-3xl
          sm:text-4xl
          font-black
          text-orange-400
          ">

          ₹<%= deposit_amount %>

        </h3>

        <%= form.hidden_field :deposit_amount,
            value: deposit_amount,
            id: "deposit-hidden" %>

      </div>



      <div class="bg-white/5 p-6 rounded-3xl">

        <p class="text-gray-400 uppercase font-bold text-sm">
          Total
        </p>

        <h3
          id="total-amount"
          class="
          mt-3
          text-3xl
          sm:text-4xl
          font-black
          ">

          ₹<%= base_amount %>

        </h3>

      </div>



      <div class="
      bg-green-500/10
      p-6
      rounded-3xl
      ">

        <p class="
        text-green-300
        uppercase
        font-bold
        text-sm
        ">
          Pay Later
        </p>

        <h3
          id="remaining-amount"
          class="
          mt-3
          text-3xl
          sm:text-4xl
          font-black
          text-green-400
          ">

          ₹<%= remaining_amount %>

        </h3>

      </div>

    </div>


    <%= form.submit "Reserve Table & Pre-order Meals", class: " mt-10 w-full bg-orange-500 hover:bg-orange-600 py-5 rounded-[28px] text-xl font-black cursor-pointer transition" %>

  </div>

<% end %>


<script>

document.addEventListener(
"turbo:load",
()=>{


const search=
document.getElementById(
"food-search"
)

if(search&&!search.dataset.loaded){

search.dataset.loaded=true

search.addEventListener(
"input",
(e)=>{

const q=
e.target.value.toLowerCase()

document
.querySelectorAll(
"[data-food-card]"
)
.forEach(card=>{

card.style.display=
card.dataset.name.includes(q)
? ""
: "none"

})

})

}



const button=
document.getElementById(
"load-more-food"
)

if(button&&!button.dataset.loaded){

button.dataset.loaded=true

button.addEventListener(
"click",
()=>{

document
.querySelectorAll(
".extra-food"
)
.forEach(card=>{

card.classList.remove(
"hidden"
)

})

button.remove()

})

}



const boxes=
document.querySelectorAll(
".food-checkbox"
)

if(!boxes.length) return


const baseAmount=
<%= @room.price.to_i %>


const total=
document.getElementById(
"total-amount"
)

const deposit=
document.getElementById(
"deposit-amount"
)

const remaining=
document.getElementById(
"remaining-amount"
)

const hidden=
document.getElementById(
"deposit-hidden"
)



function calculate(){

let foodTotal=0

boxes.forEach(box=>{

if(box.checked){

foodTotal+=parseInt(
box.dataset.price
)

}

})


const grandTotal=
baseAmount+foodTotal


const depositAmount=
Math.round(
grandTotal*0.2
)

const remainingAmount=
grandTotal-
depositAmount


total.innerText=
`₹${grandTotal}`

deposit.innerText=
`₹${depositAmount}`

remaining.innerText=
`₹${remainingAmount}`

hidden.value=
depositAmount

}



boxes.forEach(box=>{

box.addEventListener(
"change",
calculate
)

})

calculate()

})

</script>