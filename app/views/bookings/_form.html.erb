<%= form_with(model: booking, class: "space-y-10") do |form| %>

  <% if booking.errors.any? %>

    <div class="rounded-[28px] border border-red-100 bg-gradient-to-r from-red-50 to-rose-50 p-6 shadow-sm">

      <div class="flex items-start gap-4">

        <div class="bg-red-100 text-red-600 p-3 rounded-2xl text-2xl shrink-0">
          ⚠️
        </div>

        <div>

          <h2 class="text-xl font-black text-red-700">
            <%= pluralize(booking.errors.count, "error") %> prevented this reservation
          </h2>

          <ul class="mt-3 space-y-2 text-sm text-red-600">

            <% booking.errors.each do |error| %>

              <li class="flex items-center gap-2">
                <span>•</span>
                <span><%= error.full_message %></span>
              </li>

            <% end %>

          </ul>

        </div>

      </div>

    </div>

  <% end %>

  <!-- Hidden Fields -->
  <%= form.hidden_field :user_id, value: current_user.id %>
  <%= form.hidden_field :room_id, value: @room.id %>
  <%= form.hidden_field :status, value: "pending" %>

  <!-- Reservation Details -->
  <div class="grid grid-cols-1 xl:grid-cols-2 gap-8">

    <!-- Reservation Time -->
    <div class="group relative overflow-hidden rounded-[32px] border border-orange-100 bg-white dark:bg-gray-900 dark:border-gray-800 p-8 shadow-lg hover:shadow-2xl transition duration-500">

      <!-- Glow -->
      <div class="absolute -top-10 -right-10 w-32 h-32 bg-orange-200 rounded-full blur-3xl opacity-30"></div>

      <div class="relative z-10">

        <div class="flex items-center gap-4 mb-7">

          <div class="bg-gradient-to-br from-orange-400 to-orange-500 text-white w-16 h-16 rounded-3xl flex items-center justify-center text-3xl shadow-lg">
            🍽
          </div>

          <div>

            <h3 class="text-2xl font-black text-gray-900 dark:text-white">
              Reservation Time
            </h3>

            <p class="text-gray-500 dark:text-gray-400 mt-1">
              Choose your preferred dining schedule
            </p>

          </div>

        </div>

        <%= form.datetime_field :reservation_time,
          class: "w-full rounded-2xl border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-white px-5 py-4 text-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 shadow-sm",
          required: true,
          min: Time.current.strftime('%Y-%m-%dT%H:%M') %>

      </div>

    </div>

    <!-- Guest Count -->
    <div class="group relative overflow-hidden rounded-[32px] border border-blue-100 bg-white dark:bg-gray-900 dark:border-gray-800 p-8 shadow-lg hover:shadow-2xl transition duration-500">

      <!-- Glow -->
      <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-blue-200 rounded-full blur-3xl opacity-30"></div>

      <div class="relative z-10">

        <div class="flex items-center gap-4 mb-7">

          <div class="bg-gradient-to-br from-blue-400 to-blue-500 text-white w-16 h-16 rounded-3xl flex items-center justify-center text-3xl shadow-lg">
            👥
          </div>

          <div>

            <h3 class="text-2xl font-black text-gray-900 dark:text-white">
              Guest Count
            </h3>

            <p class="text-gray-500 dark:text-gray-400 mt-1">
              Number of guests joining the experience
            </p>

          </div>

        </div>

        <%= form.number_field :guest_count,
          min: 1,
          max: 20,
          value: 2,
          required: true,
          class: "w-full rounded-2xl border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-white px-5 py-4 text-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 shadow-sm" %>

      </div>

    </div>

  </div>

  <!-- Selected Dining Space -->
  <div class="relative overflow-hidden rounded-[36px] bg-gradient-to-r from-orange-50 via-white to-pink-50 dark:from-gray-900 dark:to-gray-800 border border-orange-100 dark:border-gray-800 shadow-2xl">

    <div class="absolute top-0 right-0 w-72 h-72 bg-orange-200 rounded-full blur-3xl opacity-20"></div>

    <div class="relative z-10 p-8 lg:p-10">

      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">

        <div class="flex flex-col sm:flex-row gap-6 items-start sm:items-center">

          <% if @room.image.attached? %>

            <%= image_tag @room.image,
              class: "w-full sm:w-44 h-44 object-cover rounded-[28px] shadow-2xl border-4 border-white" %>

          <% end %>

          <div>

            <span class="inline-flex items-center gap-2 bg-orange-100 text-orange-700 px-4 py-2 rounded-full text-xs font-black uppercase tracking-wider">
              ✨ Premium Dining Space
            </span>

            <h3 class="mt-5 text-4xl font-black text-gray-900 dark:text-white">
              <%= @room.room_type %>
            </h3>

            <p class="mt-4 text-gray-600 dark:text-gray-300 text-lg leading-relaxed max-w-xl">
              Enjoy curated ambience, luxury interiors,
              personalized service, and chef-crafted cuisine.
            </p>

            <div class="flex flex-wrap gap-3 mt-6">

              <span class="bg-white/80 dark:bg-gray-800 px-4 py-2 rounded-2xl text-sm font-bold text-gray-700 dark:text-white shadow-sm">
                🍷 Fine Dining
              </span>

              <span class="bg-white/80 dark:bg-gray-800 px-4 py-2 rounded-2xl text-sm font-bold text-gray-700 dark:text-white shadow-sm">
                🎵 Live Ambience
              </span>

              <span class="bg-white/80 dark:bg-gray-800 px-4 py-2 rounded-2xl text-sm font-bold text-gray-700 dark:text-white shadow-sm">
                ⚡ Instant Reservation
              </span>

            </div>

          </div>

        </div>

        <!-- Pricing -->
        <div class="bg-white dark:bg-gray-900 rounded-[32px] p-8 shadow-xl border border-gray-100 dark:border-gray-800 min-w-[240px]">

          <p class="text-sm uppercase tracking-[0.25em] font-black text-gray-400">
            Reservation Price
          </p>

          <div class="mt-5 flex items-end gap-1">

            <span class="text-4xl font-black text-orange-500">
              ₹
            </span>

            <span class="text-6xl font-black text-orange-600 leading-none">
              <%= @room.price.to_i %>
            </span>

          </div>

          <p class="text-gray-500 dark:text-gray-400 mt-3">
            Premium dining experience
          </p>

        </div>

      </div>

    </div>

  </div>

  <!-- Food Selection -->
  <div class="bg-white dark:bg-gray-900 rounded-[36px] border border-gray-100 dark:border-gray-800 shadow-2xl overflow-hidden">

    <!-- Header -->
    <div class="px-8 py-7 border-b border-gray-100 dark:border-gray-800 bg-gradient-to-r from-red-50 to-orange-50 dark:from-gray-900 dark:to-gray-800">

      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">

        <div class="flex items-center gap-4">

          <div class="bg-gradient-to-br from-red-400 to-orange-500 text-white w-16 h-16 rounded-3xl flex items-center justify-center text-3xl shadow-lg">
            🍔
          </div>

          <div>

            <h3 class="text-3xl font-black text-gray-900 dark:text-white">
              Gourmet Meal Selection
            </h3>

            <p class="text-gray-500 dark:text-gray-400 mt-1">
              Pre-order dishes for instant serving at your table
            </p>

          </div>

        </div>

        <div class="bg-white dark:bg-gray-800 px-5 py-3 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700">

          <p class="text-sm font-bold text-orange-600">
            🍽 Chef Crafted Menu
          </p>

        </div>

      </div>

    </div>

    <!-- Food Grid -->
    <div class="p-8 grid grid-cols-1 lg:grid-cols-2 gap-6">

      <% @motel.food_items.each do |item| %>

        <label class="group relative flex gap-5 rounded-[30px] border border-gray-100 dark:border-gray-800 bg-gray-50/70 dark:bg-gray-800/50 p-5 cursor-pointer hover:border-orange-300 hover:shadow-xl transition duration-300">

          <input
            type="checkbox"
            name="booking[food_item_ids][]"
            value="<%= item.id %>"
            class="mt-3 rounded border-gray-300 text-orange-500 focus:ring-orange-500"
          >

          <% if item.image.attached? %>

            <%= image_tag item.image,
              class: "w-28 h-28 object-cover rounded-[24px] shadow-lg shrink-0" %>

          <% end %>

          <div class="flex-1">

            <div class="flex items-start justify-between gap-4">

              <div>

                <h4 class="text-xl font-black text-gray-900 dark:text-white group-hover:text-orange-600 transition">
                  <%= item.name %>
                </h4>

                <p class="mt-3 text-sm leading-relaxed text-gray-500 dark:text-gray-400">
                  Fresh ingredients, premium preparation,
                  and chef-special presentation.
                </p>

              </div>

              <div class="text-right">

                <div class="text-2xl font-black text-orange-600">
                  ₹<%= item.price.to_i %>
                </div>

                <div class="text-xs text-gray-400 mt-2">
                  ⏱ <%= item.prep_time_minutes %> mins
                </div>

              </div>

            </div>

          </div>

        </label>

      <% end %>

    </div>

  </div>

  <!-- Payment -->
  <div class="relative overflow-hidden rounded-[40px] bg-gradient-to-br from-gray-950 via-gray-900 to-black text-white shadow-[0_30px_80px_rgba(0,0,0,0.45)]">

    <!-- Glow -->
    <div class="absolute -top-16 -right-10 w-72 h-72 bg-orange-500/20 rounded-full blur-3xl"></div>

    <div class="relative z-10 p-8 lg:p-10">

      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-10 mb-10">

        <!-- Deposit -->
        <div>

          <p class="uppercase tracking-[0.3em] text-sm font-black text-gray-400">
            Reservation Deposit
          </p>

          <div class="flex items-end gap-2 mt-5">

            <span class="text-5xl font-black text-orange-400">
              ₹
            </span>

            <%= form.text_field :deposit_amount,
              value: (@room.price * 0.2).to_i,
              readonly: true,
              class: "bg-transparent border-none p-0 text-6xl font-black text-orange-400 w-40 focus:ring-0" %>

          </div>

        </div>

        <!-- Total -->
        <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-[32px] px-8 py-6">

          <p class="uppercase tracking-[0.25em] text-sm font-black text-gray-400">
            Dining Experience
          </p>

          <h3 class="mt-4 text-5xl font-black text-white">
            ₹<%= @room.price.to_i %>
          </h3>

        </div>

      </div>

      <!-- CTA -->
      <%= form.submit "Reserve Table & Pre-order Meals",
        class: "w-full bg-gradient-to-r from-orange-500 via-orange-400 to-pink-500 hover:from-orange-400 hover:to-pink-400 text-white py-5 rounded-[28px] text-xl font-black shadow-2xl transition duration-300 hover:scale-[1.01] active:scale-[0.99] cursor-pointer" %>

    </div>

  </div>

<% end %>