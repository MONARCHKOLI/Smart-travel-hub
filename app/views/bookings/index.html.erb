<% content_for :title, "Bookings" %>

<div class="min-h-screen py-10 sm:py-14 px-4 sm:px-6 lg:px-8">

  <div class="max-w-7xl mx-auto">

    <!-- Search + Filters -->

      <div class="mb-10">

        <%= form_with url: bookings_path,
            method: :get,
            local: true,
            id:"booking-filter-form" do |f| %>
            
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
            
            <!-- Search -->
            <div class="relative lg:col-span-1">
            
              <%= f.text_field :query,
                  value: params[:query],
                  id:"booking-search",
                  autocomplete:"off",
                  placeholder:"Search reservation or dining space...",
                  class:"
                  w-full
                  bg-white
                  border border-gray-200
                  rounded-2xl
                  pl-12
                  pr-4
                  py-4
                  shadow-sm
                  focus:ring-2
                  focus:ring-orange-500
                  focus:outline-none
                  " %>
                  
              <div class="absolute left-4 top-1/2 -translate-y-1/2">
                  
                🔍
                  
              </div>
                  
            </div>
                  
                  
            <!-- Status -->
                  
            <%= f.select :status,
                  
            [
              ["All Status",""],
              ["Pending","pending"],
              ["Confirmed","confirmed"],
              ["Rejected","rejected"]
            ],
          
            {
              selected:
              params[:status]
            },
          
            class:"
            w-full
            rounded-2xl
            border-gray-200
            py-4
            shadow-sm
            " %>
            
            
            
            <!-- Guest Filter -->
            
            <%= f.select :guests,
            
            [
              ["Guests",""],
              ["2+ Guests","2"],
              ["4+ Guests","4"],
              ["6+ Guests","6"]
            ],
          
            {
            selected:
            params[:guests]
            },
          
            class:"
            w-full
            rounded-2xl
            border-gray-200
            py-4
            shadow-sm
            " %>
            
          </div>
            
        <% end %>
            
      </div>

    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 mb-10">

      <div>

        <span class="inline-flex items-center gap-2 bg-orange-100 text-orange-700 px-4 py-2 rounded-full text-xs sm:text-sm font-bold">
          🍽 Smart Reservations
        </span>

        <h1 class="mt-4 text-3xl sm:text-4xl md:text-5xl font-black text-gray-900">
          My Reservations
        </h1>

        <p class="mt-2 text-sm sm:text-base text-gray-500">
          Manage upcoming dining reservations.
        </p>

        <% if @bookings.respond_to?(:total_count) %>

          <div class="mt-4 inline-flex bg-orange-50 text-orange-700 px-4 py-2 rounded-2xl text-sm font-bold">

            📋 <%= @bookings.total_count %> Reservations

          </div>

        <% end %>

      </div>


      <%= link_to "＋ New Reservation",
          motels_path,
          class:"
          w-full
          sm:w-auto
          text-center
          bg-orange-500
          hover:bg-orange-600
          text-white
          px-6
          py-3
          rounded-2xl
          font-bold
          shadow-lg
          transition
          " %>

    </div>


    <% if @bookings.any? %>

      <!-- Cards -->

      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">

        <% @bookings.each do |booking| %>

          <div class="
          bg-white
          border border-gray-100
          rounded-[30px]
          overflow-hidden
          shadow-sm
          hover:shadow-xl
          transition
          ">

            <!-- Image -->

            <% if booking.room&.image&.attached? %>

              <%= image_tag booking.room.image,
                  class:"
                  w-full
                  h-52 sm:h-56
                  object-cover
                  " %>

            <% else %>

              <div class="
              w-full
              h-52 sm:h-56
              bg-gray-100
              flex
              items-center
              justify-center
              text-6xl
              ">

                🍽

              </div>

            <% end %>


            <div class="p-5 sm:p-6">

              <div class="flex justify-between items-start gap-3">

                <div class="min-w-0">

                  <h2 class="text-xl font-black truncate">

                    <%= booking.room&.room_type ||
                    "Dining Space" %>

                  </h2>

                  <p class="text-sm text-gray-400">

                    Reservation #<%= booking.id %>

                  </p>

                </div>


                <%
                  badge_class =
                    case booking.status.to_s
                    when "pending"
                      "bg-red-100 text-red-700"
                    when "confirmed"
                      "bg-green-100 text-green-700"
                    when "rejected"
                      "bg-gray-200 text-gray-700"
                    else
                      "bg-blue-100 text-blue-700"
                    end
                %>

                <span class="<%= badge_class %> px-3 py-1 rounded-xl text-xs font-bold capitalize whitespace-nowrap">

                  <%= booking.status.presence || "confirmed" %>

                </span>

              </div>



              <!-- Info -->

              <div class="mt-6 space-y-3">

                <div class="flex justify-between">

                  <span class="text-gray-500">
                    🍽 Time
                  </span>

                  <span class="font-semibold text-sm">

                    <%= booking.reservation_time
                    &.strftime("%d %b · %I:%M %p") || "-" %>

                  </span>

                </div>


                <div class="flex justify-between">

                  <span class="text-gray-500">

                    👥 Guests

                  </span>

                  <span class="font-semibold">

                    <%= booking.guest_count || 2 %>

                  </span>

                </div>

              </div>


              <!-- Actions -->

              <div class="
              mt-8
              flex
              flex-wrap
              sm:flex-nowrap
              gap-3
              ">

                <%= link_to booking,
                    class:"
                    flex-1
                    min-w-full
                    sm:min-w-0
                    bg-orange-500
                    hover:bg-orange-600
                    text-white
                    py-3
                    rounded-2xl
                    font-bold
                    text-center
                    transition
                    " do %>

                    View Reservation

                <% end %>


                <%= link_to edit_booking_path(booking),
                  class:"
                  w-full sm:w-12
                  h-12
                  bg-gray-100
                  hover:bg-amber-100
                  rounded-2xl
                  flex
                  items-center
                  justify-center
                  transition
                  " do %>

                  ✏️

                <% end %>


                <%= button_to booking,
                    method: :delete,
                    form_class:"contents",
                    class:"
                    w-full sm:w-12
                    h-12
                    bg-gray-100
                    hover:bg-red-100
                    rounded-2xl
                    flex
                    items-center
                    justify-center
                    transition
                    cursor-pointer
                    ",
                    data:{
                    turbo_confirm:
                    "Cancel reservation?"
                    } do %>

                  🗑

                <% end %>

              </div>

            </div>

          </div>

        <% end %>

      </div>


      <!-- Pagination -->

      <% if @bookings.respond_to?(:total_pages) &&
            @bookings.total_pages > 1 %>

        <div class="mt-14 flex justify-center px-4">

          <div class="
          bg-white
          max-w-full
          overflow-x-auto
          px-3 sm:px-6
          py-3 sm:py-4
          rounded-2xl
          sm:rounded-3xl
          shadow-xl
          ">

            <div class="flex justify-center min-w-max">

              <%= paginate @bookings %>

            </div>

          </div>

        </div>

      <% end %>


    <% else %>

      <div class="
      bg-white
      rounded-[30px]
      shadow-sm
      border border-gray-100
      py-14 sm:py-20
      px-6
      text-center
      ">

        <div class="text-6xl sm:text-7xl mb-5">

          🍽

        </div>

        <h2 class="text-2xl sm:text-3xl font-black">

          No Reservations Yet

        </h2>

        <p class="mt-3 text-gray-500">

          Start by reserving your first dining experience.

        </p>

        <%= link_to "Reserve Table",
            motels_path,
            class:"
            mt-8
            inline-flex
            bg-orange-500
            hover:bg-orange-600
            text-white
            px-8
            py-4
            rounded-2xl
            font-bold
            " %>

      </div>

    <% end %>

  </div>

</div>

<script>

document.addEventListener(
"turbo:load",
()=>{

const form=
document.getElementById(
"booking-filter-form"
)

const input=
document.getElementById(
"booking-search"
)

if(!form || !input) return

if(input.dataset.loaded)
return

input.dataset.loaded=true


let timer


input.addEventListener(
"input",
()=>{

clearTimeout(timer)

timer=setTimeout(()=>{

form.requestSubmit()

},500)

})


form
.querySelectorAll("select")
.forEach(select=>{

select.addEventListener(
"change",
()=>{

form.requestSubmit()

})

})

})

</script>