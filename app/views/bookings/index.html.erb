<% content_for :title, "Bookings" %>

<div class="min-h-screen py-14 px-4 sm:px-6 lg:px-8">

  <div class="max-w-7xl mx-auto">

    <!-- Header -->
    <div class="flex items-center justify-between flex-wrap gap-6 mb-10">

      <div>

        <span class="inline-flex items-center gap-2 bg-orange-100 text-orange-700 px-4 py-2 rounded-full text-sm font-bold">
          🍽 Smart Reservations
        </span>

        <h1 class="mt-4 text-4xl font-black text-gray-900">
          My Reservations
        </h1>

        <p class="mt-2 text-gray-500">
          Manage upcoming dining reservations.
        </p>

      </div>

      <%= link_to "＋ New Reservation",
        motels_path,
        class: "bg-orange-500 hover:bg-orange-600 px-6 py-3 rounded-2xl font-bold shadow-lg transition" %>

    </div>


    <% if @bookings.any? %>

      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">

        <% @bookings.each do |booking| %>

          <div class="bg-white border border-gray-100 rounded-[30px] overflow-hidden shadow-sm hover:shadow-xl transition">

            <!-- Image -->
            <% if booking.room&.image&.attached? %>

              <%= image_tag booking.room.image,
                  class: "w-full h-48 object-cover" %>

            <% else %>

              <div class="w-full h-48 bg-gray-100 flex items-center justify-center text-5xl">
                🍽
              </div>

            <% end %>

            <!-- Content -->
            <div class="p-6">

              <div class="flex justify-between items-start">

                <div>

                  <h2 class="text-xl font-black text-gray-900">
                    <%= booking.room&.room_type || "Dining Space" %>
                  </h2>

                  <p class="text-sm text-gray-400 mt-1">
                    Reservation #<%= booking.id %>
                  </p>

                </div>

                <span class="bg-green-100 text-green-700 px-3 py-1 rounded-xl text-xs font-bold capitalize">
                  <%= booking.status || "confirmed" %>
                </span>

              </div>


              <!-- Reservation Info -->
              <div class="mt-6 space-y-3">

                <div class="flex items-center justify-between">

                  <span class="text-gray-500">
                    🍽 Time
                  </span>

                  <span class="font-semibold">

                    <%= booking.reservation_time.strftime("%d %b · %I:%M %p") rescue "-" %>

                  </span>

                </div>

                <div class="flex items-center justify-between">

                  <span class="text-gray-500">
                    👥 Guests
                  </span>

                  <span class="font-semibold">
                    <%= booking.guest_count || 2 %>
                  </span>

                </div>

              </div>


              <!-- Actions -->
              <div class="mt-8 flex items-center gap-3">
                                
                <!-- Main CTA -->
                <%= link_to booking,
                  class:"flex-1 bg-orange-500 hover:bg-orange-600 py-3 rounded-2xl font-bold text-center shadow-sm transition duration-300" do %>
                  
                  View Reservation
                  
                <% end %>
                  
                  
                <!-- Edit -->
                <%= link_to edit_booking_path(booking),
                  class:"w-12 h-12 bg-gray-100 hover:bg-amber-100 hover:text-amber-600 rounded-2xl flex items-center justify-center transition duration-300 shadow-sm" do %>
                  
                  ✏️
                  
                <% end %>
                  
                  
                <!-- Cancel -->
                <%= button_to booking,
                  method: :delete,
                  form_class: "contents",
                  class:"w-12 h-12 bg-gray-100 hover:bg-red-100 hover:text-red-600 rounded-2xl flex items-center justify-center transition duration-300 shadow-sm cursor-pointer",
                  data:{ turbo_confirm:"Cancel reservation?" } do %>
                  
                  🗑
                  
                <% end %>
                  
              </div>

            </div>

          </div>

        <% end %>

      </div>

    <% else %>

      <div class="bg-white rounded-[30px] shadow-sm border border-gray-100 py-20 text-center">

        <div class="text-7xl mb-5">
          🍽
        </div>

        <h2 class="text-3xl font-black">
          No Reservations Yet
        </h2>

        <p class="mt-3 text-gray-500">
          Start by reserving your first dining experience.
        </p>

        <%= link_to "Reserve Table",
          motels_path,
          class:"mt-8 inline-flex bg-orange-500 hover:bg-orange-600 px-8 py-4 rounded-2xl font-bold" %>

      </div>

    <% end %>

  </div>

</div>