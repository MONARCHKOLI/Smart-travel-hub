<div id="<%= dom_id booking %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">User:</strong>
    <%= booking.user_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Room:</strong>
    <%= booking.room_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Reservation Time:</strong>
    <%= booking.reservation_time %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= booking.status %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Deposit amount:</strong>
    <%= booking.deposit_amount %>
  </div>
</div>
