<% content_for :title, "New Reservation" %>

<div class="min-h-screen py-16 sm:py-20 px-4 sm:px-6 lg:px-8">

  <div class="max-w-7xl mx-auto">

    <!-- Header -->
    <div class="mb-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">

      <div>

        <span class="inline-flex items-center gap-2 bg-orange-100 text-orange-700 px-4 py-2 rounded-full text-sm font-bold">
          🍽 Smart Reservation
        </span>

        <h1 class="mt-4 text-4xl md:text-5xl font-black text-gray-900 dark:text-white">

          Reserve Your Table

        </h1>

        <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-2xl">

          Reserve premium dining spaces, pre-order meals,
          and enjoy a seamless dine-in experience.

        </p>

      </div>


      <%= link_to "← Back",
          motel_path(@room.motel),
          class:"
          inline-flex
          items-center
          justify-center
          bg-white
          dark:bg-gray-900
          border
          border-gray-200
          dark:border-gray-800
          px-6
          py-3
          rounded-2xl
          font-bold
          shadow-sm
          hover:shadow-lg
          transition
          " %>

    </div>


    <!-- Form Container -->

    <div class="relative">

      <!-- background effects -->

      <div class="
      absolute
      -top-10
      -right-10
      w-64
      h-64
      bg-orange-200
      blur-3xl
      opacity-20
      rounded-full
      -z-10
      "></div>


      <div class="
      absolute
      -bottom-10
      -left-10
      w-64
      h-64
      bg-pink-200
      blur-3xl
      opacity-20
      rounded-full
      -z-10
      "></div>


      <div class="
      bg-white/95
      dark:bg-gray-950
      backdrop-blur-xl
      rounded-[36px]
      border
      border-gray-100
      dark:border-gray-800
      shadow-2xl
      overflow-hidden
      ">

        <div class="
        px-8
        py-7
        border-b
        border-gray-100
        dark:border-gray-800
        bg-gradient-to-r
        from-orange-50
        to-red-50
        dark:from-gray-900
        dark:to-gray-800
        ">

          <h2 class="text-2xl font-black text-gray-900 dark:text-white">

            Reservation Details

          </h2>

          <p class="text-gray-500 mt-2">

            Fill in your reservation information.

          </p>

        </div>


        <div class="p-6 sm:p-10">

          <%= render "form",
              booking: @booking %>

        </div>

      </div>

    </div>

  </div>

</div>