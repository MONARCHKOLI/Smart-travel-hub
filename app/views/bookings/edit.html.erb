<% content_for :title, "Edit Booking" %>

<div class="min-h-screen py-16 sm:py-20 px-4 sm:px-6 lg:px-8">

  <div class="max-w-5xl mx-auto">

    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 mb-10">

      <!-- Left -->
      <div>

        <span class="inline-flex items-center gap-2 bg-amber-100 text-amber-700 px-4 py-2 rounded-full text-sm font-bold shadow-sm">
          ✏️ Edit Reservation
        </span>

        <h1 class="mt-5 text-4xl md:text-5xl font-black tracking-tight text-gray-900">
          Update Booking Details
        </h1>

        <p class="mt-3 text-lg text-gray-500 max-w-2xl leading-relaxed">
          Modify reservation schedules, stay details,
          and pre-booked services for your trip.
        </p>

      </div>

      <!-- Right -->
      <div class="flex flex-wrap items-center gap-4">

        <%= link_to "👁 View Booking",
          @booking,
          class: "inline-flex items-center justify-center bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 px-6 py-3 rounded-2xl font-semibold shadow-sm hover:shadow-md transition duration-300" %>

        <%= link_to "← Back to Bookings",
          bookings_path,
          class: "inline-flex items-center justify-center bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-2xl font-bold shadow-lg hover:shadow-xl transition duration-300" %>

      </div>

    </div>

    <!-- Form Section -->
    <div class="relative">

      <!-- Glow Effects -->
      <div class="absolute -top-10 -right-10 w-56 h-56 bg-amber-300 rounded-full blur-3xl opacity-20 -z-10"></div>

      <div class="absolute -bottom-10 -left-10 w-56 h-56 bg-orange-300 rounded-full blur-3xl opacity-20 -z-10"></div>

      <!-- Main Card -->
      <div class="bg-white/95 backdrop-blur-xl border border-gray-100 rounded-[32px] shadow-2xl overflow-hidden">

        <!-- Card Header -->
        <div class="px-8 sm:px-10 py-7 border-b border-gray-100 bg-gradient-to-r from-amber-50 to-orange-50">

          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">

            <div>

              <h2 class="text-2xl font-black text-gray-900">
                Edit Booking Information
              </h2>

              <p class="text-gray-500 mt-2">
                Reservation ID:
                <span class="font-bold text-gray-700">
                  #<%= @booking.id %>
                </span>
              </p>

            </div>

            <div class="bg-green-100 text-green-700 px-4 py-2 rounded-2xl text-sm font-bold shadow-sm capitalize">
              <%= @booking.status || "Confirmed" %>
            </div>

          </div>

        </div>

        <!-- Form -->
        <div class="px-6 sm:px-10 py-8">

          <%= render "form", booking: @booking %>

        </div>

      </div>

    </div>

  </div>

</div>