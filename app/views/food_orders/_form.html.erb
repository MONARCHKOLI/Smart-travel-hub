<%= form_with(model: food_order, class: "contents") do |form| %>
  <% if food_order.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(food_order.errors.count, "error") %> prohibited this food_order from being saved:</h2>

      <ul class="list-disc ml-6">
        <% food_order.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :booking_id %>
    <%= form.text_field :booking_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": food_order.errors[:booking_id].none?, "border-red-400 focus:outline-red-600": food_order.errors[:booking_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :food_item_id %>
    <%= form.text_field :food_item_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": food_order.errors[:food_item_id].none?, "border-red-400 focus:outline-red-600": food_order.errors[:food_item_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :quantity %>
    <%= form.number_field :quantity, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": food_order.errors[:quantity].none?, "border-red-400 focus:outline-red-600": food_order.errors[:quantity].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :status %>
    <%= form.text_field :status, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": food_order.errors[:status].none?, "border-red-400 focus:outline-red-600": food_order.errors[:status].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :scheduled_ready_time %>
    <%= form.datetime_field :scheduled_ready_time, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": food_order.errors[:scheduled_ready_time].none?, "border-red-400 focus:outline-red-600": food_order.errors[:scheduled_ready_time].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
