<div id="<%= dom_id food_order %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Booking:</strong>
    <%= food_order.booking_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Food item:</strong>
    <%= food_order.food_item_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Quantity:</strong>
    <%= food_order.quantity %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= food_order.status %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Scheduled ready time:</strong>
    <%= food_order.scheduled_ready_time %>
  </div>
</div>
