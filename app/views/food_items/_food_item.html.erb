<div id="<%= dom_id food_item %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Motel:</strong>
    <%= food_item.motel_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= food_item.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Price:</strong>
    <%= food_item.price %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Prep time minutes:</strong>
    <%= food_item.prep_time_minutes %>
  </div>
</div>
