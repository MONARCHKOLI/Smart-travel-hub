<%= form_with(model: food_item, class: "contents") do |form| %>
  <% if food_item.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(food_item.errors.count, "error") %> prohibited this food_item from being saved:</h2>

      <ul class="list-disc ml-6">
        <% food_item.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :motel_id %>
    <%= form.text_field :motel_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": food_item.errors[:motel_id].none?, "border-red-400 focus:outline-red-600": food_item.errors[:motel_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": food_item.errors[:name].none?, "border-red-400 focus:outline-red-600": food_item.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :price %>
    <%= form.text_field :price, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": food_item.errors[:price].none?, "border-red-400 focus:outline-red-600": food_item.errors[:price].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :prep_time_minutes %>
    <%= form.number_field :prep_time_minutes, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": food_item.errors[:prep_time_minutes].none?, "border-red-400 focus:outline-red-600": food_item.errors[:prep_time_minutes].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
