<div class="min-h-[85vh] flex items-center justify-center px-4" data-controller="face-lock">
  <div class="w-full max-w-md bg-white/80 backdrop-blur-lg shadow-2xl rounded-3xl p-8 border border-white/50">

    <!-- Mode Toggle -->
    <div class="flex bg-gray-100 p-1 rounded-2xl mb-8">
      <button type="button" data-action="click->face-lock#showPassword" class="flex-1 py-2 text-sm font-semibold rounded-xl transition-all" data-face-lock-target="passwordBtn">
        Password
      </button>
      <button type="button" data-action="click->face-lock#showFace" class="flex-1 py-2 text-sm font-semibold rounded-xl transition-all" data-face-lock-target="faceBtn">
        Face ID
      </button>
    </div>

    <!-- Face ID Section (Hidden by default) -->
    <div data-face-lock-target="faceSection" class="hidden animate-in fade-in duration-500">
      <div class="text-center mb-6">
        <div class="text-5xl mb-3">📸</div>
        <h2 class="text-2xl font-bold text-gray-800">Biometric Login</h2>
        <p class="text-gray-500 text-sm mt-1" data-face-lock-target="status">Ready to scan</p>
      </div>

      <div class="relative overflow-hidden rounded-2xl bg-gray-900 aspect-video mb-6 border-4 border-blue-100">
        <video data-face-lock-target="video" autoplay muted class="w-full h-full object-cover"></video>
      </div>

      <button type="button" data-action="click->face-lock#authenticate" 
              class="w-full bg-blue-600 hover:bg-blue-700 text-white py-4 rounded-xl font-bold shadow-lg transition-all active:scale-95">
        Scan My Face
      </button>
    </div>

    <!-- Password Section -->
    <div data-face-lock-target="passwordSection">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5", data: { face_lock_target: "form" } }) do |f| %>
        <div>
          <%= f.label :email, class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.email_field :email, autofocus: true, class: "w-full rounded-xl border border-gray-300 px-4 py-3 focus:ring-2 focus:ring-blue-500" %>
        </div>
        <div>
          <%= f.label :password, class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.password_field :password, class: "w-full rounded-xl border border-gray-300 px-4 py-3 focus:ring-2 focus:ring-blue-500" %>
        </div>
        <%= f.submit "Login with Password", class: "w-full bg-gray-900 hover:bg-black text-white py-4 rounded-xl font-semibold shadow-lg cursor-pointer" %>
      <% end %>
    </div>

    <div class="mt-6 text-center text-sm text-gray-600">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
