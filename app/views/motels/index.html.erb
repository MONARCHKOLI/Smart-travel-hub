<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

  <!-- Header -->
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 mb-10">

    <div>

      <h1 class="text-4xl md:text-5xl font-black text-gray-900 tracking-tight">
        Explore Restaurants
      </h1>

      <p class="text-gray-500 mt-3 text-base">
        Discover premium dining experiences and reserve your perfect table.
      </p>

      <div class="mt-4 inline-flex items-center bg-blue-50 text-blue-700 px-4 py-2 rounded-2xl text-sm font-bold">

        🍽 <%= @motels.total_count rescue @motels.count %> Places Available

      </div>

    </div>

    <% if user_signed_in? %>

      <%= link_to 'Add New Motel',
        new_motel_path,
        class: "
        inline-flex items-center justify-center gap-2
        bg-blue-600 hover:bg-blue-700
        text-white px-6 py-3 rounded-2xl
        text-sm font-bold shadow-xl
        transition hover:-translate-y-1
        " %>

    <% end %>

  </div>


  <!-- Live Search -->

  <div class="mb-10">

    <%= form_with url: motels_path,
        method: :get,
        local: true,
        id:"motel-search-form" do |f| %>

      <div class="relative max-w-3xl">

        <%= f.text_field :query,
            value: params[:query],
            autocomplete:"off",
            id:"motel-search-input",
            placeholder:"Search restaurant, city, location...",
            class:"
            w-full
            bg-white
            border border-gray-200
            rounded-3xl
            pl-14
            pr-28
            py-5
            shadow-lg
            focus:ring-2
            focus:ring-blue-500
            focus:outline-none
            text-gray-700
            " %>

        <div class="absolute left-5 top-1/2 -translate-y-1/2 text-gray-400">

          🔍

        </div>

        <% if params[:query].present? %>

          <%= link_to "✕",
            motels_path,
            class:"
            absolute
            right-5
            top-1/2
            -translate-y-1/2
            text-gray-400
            hover:text-red-500
            text-lg
            font-bold
            " %>

        <% end %>

      </div>

    <% end %>

  </div>



  <!-- Motel Grid -->

  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">

    <% @motels.each do |motel| %>

      <div class="group bg-white/80 backdrop-blur-xl rounded-[28px] overflow-hidden border border-gray-100 shadow-md hover:shadow-2xl transition-all duration-500">

        <div class="relative h-64 overflow-hidden">

          <% if motel.image.attached? %>

            <%= image_tag motel.image,
            class:"
            w-full h-full object-cover
            group-hover:scale-110
            transition duration-700
            " %>

          <% else %>

            <div class="w-full h-full bg-gray-100 flex items-center justify-center">

              <span class="text-6xl">🍽</span>

            </div>

          <% end %>

          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20"></div>

          <div class="absolute bottom-5 left-5 right-5">

            <h2 class="text-white text-2xl font-black">

              <%= motel.name %>

            </h2>

          </div>

          <div class="absolute top-4 right-4 bg-white/90 px-3 py-2 rounded-2xl shadow flex gap-2 items-center">

            🌤️

            <span class="text-xs font-bold">

              <%= @weather&.dig(
                "hours",0,
                "airTemperature","noaa"
              )&.round || 24 %>°C

            </span>

          </div>

        </div>

        <div class="p-6">

          <div class="flex gap-3 mb-5">

            <div class="bg-red-50 p-2 rounded-xl">

              📍

            </div>

            <div>

              <p class="text-xs uppercase tracking-wider text-gray-400 font-bold">

                Location

              </p>

              <p class="text-gray-700 font-medium">

                <%= motel.address %>

              </p>

            </div>

          </div>

          <p class="text-gray-500 text-sm line-clamp-2 min-h-[44px]">

            <%= motel.description.presence ||
              "Premium dining experience with smart reservations." %>

          </p>

          <div class="flex justify-between items-end mt-7">

            <div>

              <p class="text-xs uppercase text-gray-400 font-bold">

                Starting At

              </p>

              <span class="text-3xl font-black text-blue-600">

                ₹<%= motel.amount.to_i %>

              </span>

            </div>

            <%= link_to motel,
            class:"
            inline-flex items-center gap-2
            bg-gray-900 hover:bg-black
            text-white px-5 py-3 rounded-2xl
            font-bold shadow-lg
            transition hover:scale-105
            " do %>

              View →

            <% end %>

          </div>

        </div>

      </div>

    <% end %>

  </div>


  <!-- Pagination -->
              
  <% if @motels.respond_to?(:total_pages) && @motels.total_pages > 1 %>
              
    <div class="mt-14 flex justify-center px-4">
              
      <div class="
        bg-white
        w-full sm:w-auto
        max-w-full
        px-3 sm:px-6
        py-3 sm:py-4
        rounded-2xl sm:rounded-3xl
        shadow-xl
        overflow-x-auto
      ">
              
        <div class="flex justify-center min-w-max">
              
          <%= paginate @motels %>
              
        </div>
              
      </div>
              
    </div>
              
  <% end %>

</div>



<script>
document.addEventListener("turbo:load", () => {

  const input =
    document.getElementById(
      "motel-search-input"
    )

  const form =
    document.getElementById(
      "motel-search-form"
    )

  if(!input || !form) return

  if(input.dataset.bound) return

  input.dataset.bound="true"

  let timer

  input.addEventListener(
    "input",
    ()=>{

      clearTimeout(timer)

      timer=setTimeout(()=>{

        form.requestSubmit()

      },500)

    })

})
</script>