<div class="max-w-5xl mx-auto px-4 py-12">
  <!-- Motel Header -->
  <div class="relative h-96 rounded-3xl overflow-hidden mb-10 shadow-2xl">
    <% if @motel.image.attached? %>
      <%= image_tag @motel.image, class: "w-full h-full object-cover" %>
    <% end %>
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
    <div class="absolute bottom-8 left-8 text-white">
      <h1 class="text-5xl font-black mb-2"><%= @motel.name %></h1>
      <p class="text-lg opacity-90 italic">📍 <%= @motel.address %></p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
    <!-- Left: Room Selection -->
    <div class="lg:col-span-2 space-y-6">
      <h2 class="text-2xl font-bold text-gray-800">Select Your Room</h2>
      
      <% @motel.rooms.each do |room| %>
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:border-blue-500 transition-all flex justify-between items-center group">
          <div>
            <h3 class="text-lg font-bold text-gray-900"><%= room.room_type %></h3>
            <p class="text-gray-500 text-sm">Instant confirmation • Free cancellation</p>
          </div>
          <div class="text-right">
            <div class="text-2xl font-black text-blue-600 mb-2">$<%= room.price.to_i %></div>
            <%= link_to "Select Room", new_booking_path(room_id: room.id), 
                class: "bg-gray-900 text-white px-6 py-2 rounded-xl text-sm font-bold group-hover:bg-blue-600 transition" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Right: Motel Info & Quick Actions -->
    <div class="space-y-6">
      <div class="bg-blue-50 p-8 rounded-3xl border border-blue-100 text-center">
        <h3 class="font-bold text-blue-900 mb-2">Smart Check-in</h3>
        <p class="text-sm text-blue-700 leading-relaxed">
          Book now to enable <strong>Face ID Check-in</strong> and pre-order your arrival meal.
        </p>
      </div>
    </div>
  </div>
</div>
