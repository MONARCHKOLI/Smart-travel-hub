<%= form_with(model: motel, class: "contents") do |form| %>
  <% if motel.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(motel.errors.count, "error") %> prohibited this motel from being saved:</h2>

      <ul class="list-disc ml-6">
        <% motel.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": motel.errors[:name].none?, "border-red-400 focus:outline-red-600": motel.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :address %>
    <%= form.text_field :address, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": motel.errors[:address].none?, "border-red-400 focus:outline-red-600": motel.errors[:address].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :lat %>
    <%= form.text_field :lat, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": motel.errors[:lat].none?, "border-red-400 focus:outline-red-600": motel.errors[:lat].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :lon %>
    <%= form.text_field :lon, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": motel.errors[:lon].none?, "border-red-400 focus:outline-red-600": motel.errors[:lon].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :description %>
    <%= form.textarea :description, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": motel.errors[:description].none?, "border-red-400 focus:outline-red-600": motel.errors[:description].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
