<div id="<%= dom_id motel %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= motel.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Address:</strong>
    <%= motel.address %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Lat:</strong>
    <%= motel.lat %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Lon:</strong>
    <%= motel.lon %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= motel.description %>
  </div>
</div>
