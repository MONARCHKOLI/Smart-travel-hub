<div id="<%= dom_id room %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Motel:</strong>
    <%= room.motel_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Room type:</strong>
    <%= room.room_type %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Price:</strong>
    <%= room.price %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= room.status %>
  </div>
</div>
