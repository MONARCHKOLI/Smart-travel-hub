<!DOCTYPE html>
<html class="transition duration-300">
  <head>
    <title><%= content_for(:title) || "Smart Travel Hub" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <!-- Theme Init -->
    <script>
      const theme = localStorage.getItem("theme");

      if (
        theme === "dark" ||
        (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      }
    </script>

  </head>

  <body class="bg-gradient-to-br from-sky-100 via-white to-blue-200 dark:from-gray-950 dark:via-gray-900 dark:to-black min-h-screen text-gray-800 dark:text-gray-100 transition-all duration-300">

    <!-- Navbar -->
    <header class="fixed top-0 left-0 w-full bg-white/80 dark:bg-gray-900/80 backdrop-blur-xl shadow-md z-50 border-b border-white/20 dark:border-gray-800">

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="flex items-center justify-between h-16">

          <!-- Logo -->
          <div class="flex items-center gap-3">

            <div class="bg-blue-600 text-white p-2 rounded-xl shadow-lg">
              ✈️
            </div>

            <h1 class="text-xl sm:text-2xl font-black text-blue-700 dark:text-blue-400">
              Smart Travel Hub
            </h1>

          </div>

          <!-- Navigation -->
          <div class="flex items-center gap-3">

            <nav class="hidden md:flex items-center gap-5">

              <% if user_signed_in? %>

                <%= link_to "Home", root_path,
                  class: "text-gray-700 dark:text-gray-200 hover:text-blue-600 font-medium transition" %>

                <%= link_to "Motels", motels_path,
                  class: "text-gray-700 dark:text-gray-200 hover:text-blue-600 font-medium transition" %>

                <%= link_to "Bookings", bookings_path,
                  class: "text-gray-700 dark:text-gray-200 hover:text-blue-600 font-medium transition" %>

              <% end %>

            </nav>

            <!-- Weather Toggle -->
            <button
              id="weather-toggle"
              class="w-11 h-11 rounded-2xl bg-white dark:bg-gray-800 shadow-md hover:scale-105 transition flex items-center justify-center text-lg"
              title="Toggle Weather"
            >
              🌤️
            </button>

            <!-- Theme Toggle -->
            <button
              id="theme-toggle"
              class="w-11 h-11 rounded-2xl bg-white dark:bg-gray-800 shadow-md hover:scale-105 transition flex items-center justify-center text-lg"
              title="Toggle Theme"
            >
              🌙
            </button>

            <% if user_signed_in? %>

              <%= link_to "Logout",
                destroy_user_session_path,
                data: { turbo_method: :delete },
                class: "bg-red-500 hover:bg-red-600 text-white px-5 py-2.5 rounded-2xl shadow-lg transition font-semibold" %>

            <% else %>

              <%= link_to "Login",
                new_user_session_path,
                class: "bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-2xl shadow-lg transition font-semibold" %>

            <% end %>

          </div>

        </div>

      </div>

    </header>

    <!-- Main -->
    <main class="pt-24 px-4 sm:px-6 lg:px-8">

      <div class="max-w-7xl mx-auto">

        <!-- Flash -->
        <% flash.each do |type, message| %>

          <div class="mb-6">

            <div class="
              px-5 py-4 rounded-2xl shadow-lg text-white
              <%= type == 'notice' ? 'bg-green-500' : 'bg-red-500' %>
            ">
              <%= message %>
            </div>

          </div>

        <% end %>

        <%= yield %>

      </div>

    </main>

    <!-- Scripts -->
    <script>

      // THEME TOGGLE
      const themeToggle = document.getElementById("theme-toggle");

      if (themeToggle) {

        const updateThemeIcon = () => {
          themeToggle.innerHTML =
            document.documentElement.classList.contains("dark")
              ? "☀️"
              : "🌙";
        };

        updateThemeIcon();

        themeToggle.addEventListener("click", () => {

          document.documentElement.classList.toggle("dark");

          const isDark =
            document.documentElement.classList.contains("dark");

          localStorage.setItem(
            "theme",
            isDark ? "dark" : "light"
          );

          updateThemeIcon();

        });

      }

      // WEATHER TOGGLE
      const weatherToggle = document.getElementById("weather-toggle");

      if (weatherToggle) {

        let weatherEnabled =
          localStorage.getItem("weather_enabled") === "true";

        const updateWeatherIcon = () => {
          weatherToggle.innerHTML = weatherEnabled ? "🌦️" : "📴";
        };

        updateWeatherIcon();

        weatherToggle.addEventListener("click", () => {

          weatherEnabled = !weatherEnabled;

          localStorage.setItem(
            "weather_enabled",
            weatherEnabled
          );

          updateWeatherIcon();

          if (weatherEnabled) {
            fetchLocationWeather();
          }

        });

      }

      // FETCH WEATHER ONLY IF ENABLED
      function fetchLocationWeather() {

        if (!navigator.geolocation) return;

        navigator.geolocation.getCurrentPosition((position) => {

          const lat = position.coords.latitude;
          const lng = position.coords.longitude;

          const url = new URL(window.location.href);

          if (
            url.searchParams.get("lat") !== lat.toString()
          ) {

            url.searchParams.set("lat", lat);
            url.searchParams.set("lng", lng);

            window.location.href = url.toString();

          }

        });

      }

      // AUTO LOAD IF ENABLED
      if (
        localStorage.getItem("weather_enabled") === "true"
      ) {
        fetchLocationWeather();
      }

    </script>

  </body>
</html>